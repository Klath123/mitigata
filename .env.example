# AttackStory settings. Copy to .env (git-ignored) and fill in what you use, then load it:
#   Linux/macOS:  set -a; source .env; set +a
#   PowerShell:   Get-Content .env | ? { $_ -match '^[A-Z]' } | % { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }
# Everything is optional: without LLM keys the engine writes template reports and skips the agent reviews.

# LLM agents (narrator, verification agent, config agent). First provider with a key that answers wins.
GROQ_API_KEY=
GEMINI_API_KEY=
# ATTACKSTORY_LLM=0                         # disable every LLM call
# ATTACKSTORY_LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,gemini-3.5-flash
# ATTACKSTORY_LLM_THINKING=high             # Gemini thinking level
# ATTACKSTORY_GROQ_MAX_TOKENS=3500          # Groq answer budget (counts against tokens per minute)

# Windows logs: path to a Hayabusa binary (optional extra detector)
# ATTACKSTORY_HAYABUSA=/opt/hayabusa/hayabusa

# API / UI
# ATTACKSTORY_RESULTS=results               # folder of runs the API lists
# ATTACKSTORY_RUN=results/firex             # run the API opens first (default: newest)

# Alternative MITRE ATT&CK bundle (default rules/attack/enterprise-attack.json)
# ATTACK_STIX=/path/to/enterprise-attack.json
